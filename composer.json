{
    "name": "crenspire/laravel-whatsapp",
    "description": "Laravel WhatsApp Business API package",
    "type": "library",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Akshay Joshi",
            "email": "akshay.joshi@crenspire.com"
        }
    ],
    "homepage": "https://github.com/crenspire/laravel-whatsapp",
    "keywords": [
        "laravel",
        "whatsapp",
        "api",
        "messaging",
        "business"
    ],
    "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.14",
    "nesbot/carbon": "^2.0|^3.0",
    "guzzlehttp/guzzle": "^7.0"
  },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "pestphp/pest": "^2.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Crenspire\\Whatsapp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crenspire\\Whatsapp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "version:show": "php scripts/version.php show",
        "version:patch": "php scripts/version.php patch",
        "version:minor": "php scripts/version.php minor",
        "version:major": "php scripts/version.php major",
        "changelog": "git log --oneline --pretty=format:'- %s' $(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo 'HEAD~10')..HEAD",
        "release:patch": "composer version:patch && composer test && git add . && git commit -m 'Release v$(composer version:show)' && git tag v$(composer version:show)",
        "release:minor": "composer version:minor && composer test && git add . && git commit -m 'Release v$(composer version:show)' && git tag v$(composer version:show)",
        "release:major": "composer version:major && composer test && git add . && git commit -m 'Release v$(composer version:show)' && git tag v$(composer version:show)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Crenspire\\Whatsapp\\WhatsappServiceProvider"
            ],
            "aliases": {
                "Whatsapp": "Crenspire\\Whatsapp\\Facades\\Whatsapp"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
